    "pretest:e2e": "node scripts/e2e-localhost-preflight.mjs",
    "test:e2e": "playwright test",
    "pretest:e2e:ui": "node scripts/e2e-localhost-preflight.mjs",
    "test:e2e:ui": "playwright test --ui",
    "pretest:e2e:multi": "node scripts/e2e-localhost-preflight.mjs",
    "test:e2e:multi": "playwright test --config=tests/e2e/playwright.config.ts",
    "pretest:e2e:multi:ui": "node scripts/e2e-localhost-preflight.mjs",
    "test:e2e:multi:ui": "playwright test --config=tests/e2e/playwright.config.ts --ui",
    "pretest:e2e:smoke": "node scripts/e2e-localhost-preflight.mjs",
    "test:e2e:smoke": "playwright test --config=tests/e2e/playwright.config.ts --project=smoke",
    "pretest:e2e:agents": "node scripts/e2e-localhost-preflight.mjs",
    "test:e2e:agents": "playwright test --config=tests/e2e/playwright.config.ts --project=multi-agent",
    "pretest:e2e:senior": "node scripts/e2e-localhost-preflight.mjs",
    "test:e2e:senior": "playwright test --config=tests/e2e/playwright.config.ts --project=senior-terminal",
    "pretest:e2e:pilot": "node scripts/e2e-localhost-preflight.mjs",
    "test:e2e:pilot": "playwright test --config=tests/e2e/playwright.config.ts --project=pilot-smoke",
    "test:admin-login": "playwright test --config=tests/e2e/admin-login.playwright.config.ts",
    "seed:quarter": "npx tsx scripts/seed-quarter.ts",
    "seed:demo": "npx tsx scripts/seed-demo-account.ts",
    "db:types": "supabase gen types typescript --project-id uylszchlyhbpbmslcnka > lib/supabase/database.types.ts"
  },
