    "start": "next start",
    "start:local": "node scripts/start-local-production.mjs start -p 3001",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build",
    "chromatic:dry-run": "node scripts/chromatic-safe.mjs dry-run",
    "chromatic:ci": "node scripts/chromatic-safe.mjs ci",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
